{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "~/.opam/*/lib": "allow",
      "~/.opam/*/lib/**": "allow",
      "~/.gradle/caches": "allow",
      "~/.gradle/caches/**": "allow",
      "~/.m2/repository": "allow",
      "~/.m2/repository/**": "allow"
    },
    "read": {
      "~/.opam/*/lib": "allow",
      "~/.opam/*/lib/**": "allow",
      "~/.gradle/caches": "allow",
      "~/.gradle/caches/**": "allow",
      "~/.m2/repository": "allow",
      "~/.m2/repository/**": "allow"
    },
    "edit": {
      "~/.opam/*/lib": "deny",
      "~/.opam/*/lib/**": "deny",
      "~/.gradle/caches": "deny",
      "~/.gradle/caches/**": "deny",
      "~/.m2/repository": "deny",
      "~/.m2/repository/**": "deny"
    }
  }
}
