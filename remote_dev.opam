# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Remote development tool with an Android client"
description:
  "Browse Git worktrees from an Android client and send prompts to the locally installed Claude CLI."
maintainer: ["y2k <itwisterlx@gmail.com>"]
authors: ["y2k <itwisterlx@gmail.com>"]
license: "GPL-3.0-only"
tags: ["development" "git" "android"]
homepage: "https://github.com/y2k/remote-dev"
bug-reports: "https://github.com/y2k/remote-dev/issues"
depends: [
  "dune" {>= "3.24"}
  "ocaml" {>= "5.3"}
  "eio"
  "eio_main"
  "httpun-eio"
  "yojson"
  "ppx_deriving_yojson"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/y2k/remote-dev.git"
x-maintenance-intent: ["(latest)"]
